{
  "reload_style_on_change": true,
  "position": "top",
  "expand-center": true,
  "height": 36,
  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 6,
  "style": "~/.config/waybar/style.css",

  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],

  "modules-center": [
    "clock",
    "clock#date",
    "mpd",
    "mpris"
  ],

  "modules-right": [
    "cpu",
    "memory",
    "pulseaudio",
    "network",
    "bluetooth",
    "backlight",
    "battery",
    "custom/lock"
  ],

  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "all-outputs": false,
    "persistent-workspaces": {
      "*": 10
    }
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 40
  },

  "mpd": {
    "format": "{stateIcon} {title}",
    "format-paused": "{stateIcon} {title}",
    "format-stopped": "",
    "format-disconnected": "",
    "hide-empty-text": true,
    "interval": 5,
    "max-length": 24,
    "state-icons": { "paused": "󰏤", "playing": "󰐊" },
    "tooltip-format": "{artist} — {title}",
    "tooltip-format-disconnected": "MPD (disconnected)"
  },

  "mpris": {
    "format": "{status_icon} {dynamic}",
    "format-paused": "{status_icon} {dynamic}",
    "format-stopped": "",
    "hide-empty-text": true,
    "status-icons": { "playing": "▶", "paused": "⏸" },
    "dynamic-order": ["title", "artist"],
    "max-length": 40,
    "tooltip": true
  },

  "cpu": {
    "format": "󰻠 {usage}%",
    "tooltip": false,
    "on-click": "sh -c '$HOME/.local/bin/terminal-launcher -e btop'"
  },

  "memory": {
    "format": "󰍛 {percentage}%",
    "tooltip": false,
    "on-click": "sh -c '$HOME/.local/bin/terminal-launcher -e btop'"
  },

  "pulseaudio": {
    "format": "󰕾 {volume}%",
    "format-tooltip": false,
    "format-bluetooth": "󰕾 {volume}% 󰂯 {format_source}",
    "format-bluetooth-muted": "󰖁 󰂯 {format_source}",
    "format-muted": "󰖁",
    "on-click": "pavucontrol"
  },

  "network": {
    "format-wifi": "󰖩",
    "format-ethernet": "󰈀 {ipaddr}",
    "tooltip-format": "{essid}",
    "format-linked": "󰈀 {ifname}",
    "format-disconnected": "󰖪",
    "on-click": "sh -c 'if command -v nm-connection-editor >/dev/null; then nm-connection-editor; else $HOME/.local/bin/terminal-launcher -e nmtui; fi'"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-on": "󰂯",
    "format-connected": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-no-controller": "󰂲",
    "tooltip-format": "{controller_alias}",
    "tooltip-format-connected": "{controller_alias}\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "blueman-manager"
  },

  "backlight": {
    "format": "󰃟 {percent}%",
    "tooltip": false,
    "on-click": "brightnessctl set 50%",
    "on-click-right": "brightnessctl set 100%",
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-"
  },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "full-at": "80%",
    "format": "󰁹 {capacity}%",
    "format-full": "󰁹 {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-alt": "{time}"
  },

  "clock": {
    "format": "{:%I:%M}",
    "format-alt": "{:%H:%M}",
    "tooltip": false
  },

  "clock#date": {
    "format": "{:%b %d}",
    "format-alt": "{:%Y-%m-%d}"
  },

  "custom/lock": {
    "tooltip": false,
    "on-click": "sh -c '(sleep 0.5s; hyprlock)' & disown",
    "format": "󰌾"
  }

}
