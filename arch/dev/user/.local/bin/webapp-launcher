#!/usr/bin/env bash
# Launch a URL as a Chromium app window.
#
# This is the bare-Arch replacement for the web-app helper used by the
# Omarchy profile. Each URL gets its own Chromium profile so web-app sessions
# (WhatsApp, YouTube Music, etc.) stay independent.

set -euo pipefail

url="${1:?usage: webapp-launcher URL}"
shift || true

slug="$(printf '%s' "$url" |
    sed -e 's|^[a-zA-Z][a-zA-Z0-9+.-]*://||' -e 's|[^A-Za-z0-9._-]|_|g' |
    cut -c1-80)"

if command -v chromium >/dev/null 2>&1; then
    exec chromium \
        --app="$url" \
        --user-data-dir="$HOME/.local/share/webapps/$slug" \
        --no-first-run \
        --no-default-browser-check \
        "$@"
fi

if command -v zen-browser >/dev/null 2>&1; then
    exec zen-browser --new-window "$url" "$@"
fi

exec xdg-open "$url"
