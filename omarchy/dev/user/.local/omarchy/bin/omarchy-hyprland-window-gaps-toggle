#!/bin/bash

# Toggles the window gaps globally between no gaps and the defaults from looknfeel.conf

CONFIG="$HOME/.config/hypr/looknfeel.conf"

extract() {
  local key="$1"
  awk -F'[=,]' -v key="$key" '
    BEGIN { gsub(/^\$/, "", key); key = tolower(key) }
    tolower($1) ~ "^[[:space:]]*\\$?" key "[[:space:]]*$" {
      sub(/#.*/, "", $2)
      gsub(/^[[:space:]]+/, "", $2)
      gsub(/[[:space:]]+$/, "", $2)
      print $2
      exit
    }
  ' "$CONFIG"
}

# Read from user's active looknfeel.conf (fall back to hardcoded if not found)
USER_GAPS_IN=$(extract gaps_in)  || USER_GAPS_IN=5
USER_GAPS_OUT=$(extract gaps_out) || USER_GAPS_OUT=10
USER_BORDER_SIZE=$(extract border_size) || USER_BORDER_SIZE=2

# Get current gap values
current_gaps_out=$(hyprctl getoption general:gaps_out -j | jq -r '.custom' | awk '{print $1}')
current_gaps_in=$(hyprctl getoption general:gaps_in -j | jq -r '.custom' | awk '{print $1}')
current_border_size=$(hyprctl getoption general:border_size -j | jq -r '.int')

# If all are currently 0, restore to looknfeel. Otherwise set all to 0.
if [[ $current_gaps_out == "0" && $current_gaps_in == "0" && $current_border_size == "0" ]]; then
  hyprctl keyword general:gaps_out "$USER_GAPS_OUT"
  hyprctl keyword general:gaps_in "$USER_GAPS_IN"
  hyprctl keyword general:border_size "$USER_BORDER_SIZE"
else
  hyprctl keyword general:gaps_out 0
  hyprctl keyword general:gaps_in 0
  hyprctl keyword general:border_size 0
fi