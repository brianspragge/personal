#!/bin/bash

# Dock the bar at the bottom for windowsxp themes, at the top for everything
# else. Runs via omarchy-hook theme-set with the theme slug as $1.
case "$1" in
  windowsxp | windowsxp-*) pos="bottom" ;;
  *) pos="top" ;;
esac

source "${OMARCHY_PATH:-/usr/share/omarchy}/bin/omarchy-shell-config"
commit '.bar.position = $pos' --arg pos "$pos"
